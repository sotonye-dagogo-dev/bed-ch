# Database
# DATABASE_URL -> runtime only (Prisma Client in the app): transaction-mode
#   pooler endpoint (Supabase :6543, pgbouncer=true). Right for serverless.
# DIRECT_URL -> schema/migration commands only (prisma migrate dev/deploy,
#   prisma db push, prisma studio): session-capable direct/session-mode
#   endpoint (Supabase :5432). Migrations fail against the transaction pooler.
# Both are declared in prisma/schema.prisma (url + directUrl), so Prisma picks
# the right one automatically. For a local Postgres with no pooler, use the
# same connection string for both.
DATABASE_URL="postgresql://user:password@localhost:5432/bed_ch?schema=public"
DIRECT_URL="postgresql://user:password@localhost:5432/bed_ch?schema=public"

# Paystack
PAYSTACK_SECRET_KEY="sk_test_xxxxxxxxxxxxxxxxxxxxxxxx"
PAYSTACK_PUBLIC_KEY="pk_test_xxxxxxxxxxxxxxxxxxxxxxxx"
PAYSTACK_WEBHOOK_SECRET="whsec_xxxxxxxxxxxxxxxxxxxxxxxx"
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY="pk_test_xxxxxxxxxxxxxxxxxxxxxxxx"

# WhatsApp
WHATSAPP_NUMBER="234XXXXXXXXXX"
NEXT_PUBLIC_WHATSAPP_NUMBER="234XXXXXXXXXX"

# Analytics
GA4_ID="G-XXXXXXXXXX"
NEXT_PUBLIC_GA4_ID="G-XXXXXXXXXX"
META_PIXEL_ID="XXXXXXXXXX"
NEXT_PUBLIC_META_PIXEL_ID="XXXXXXXXXX"
HOTJAR_ID="XXXXXXXXXX"
NEXT_PUBLIC_HOTJAR_ID="XXXXXXXXXX"

# App
APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Email (future)
SENDGRID_API_KEY=""
SENDGRID_FROM_EMAIL=""

# Redis (future)
REDIS_URL=""